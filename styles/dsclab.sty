\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/dsclab}[2026/10/04 DSC Lab document identity]
\RequirePackage[margin=24mm,top=30mm,bottom=24mm,headheight=30pt,headsep=9mm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{eso-pic}
\RequirePackage[table]{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins}
\RequirePackage[font=small,labelfont=bf]{caption}
\RequirePackage[bottom]{footmisc}
\RequirePackage{setspace}
\RequirePackage{listings}
\RequirePackage{hyperref}
\definecolor{DSCNavy}{HTML}{142D4E}
\definecolor{DSCTeal}{HTML}{007F86}
\definecolor{DSCGold}{HTML}{C29954}
\definecolor{DSCInk}{HTML}{26364A}
\definecolor{DSCMuted}{HTML}{526579}
\definecolor{DSCPale}{HTML}{EDF5F6}
\definecolor{DSCLine}{HTML}{D7E2E9}
% Compatibility with existing content that uses these color names.
\colorlet{headercolor}{DSCNavy}
\colorlet{orgblue}{DSCTeal}
\hypersetup{unicode=true,colorlinks=true,linkcolor=DSCNavy,urlcolor=DSCTeal,citecolor=DSCTeal}
% Persian must be loaded after the layout and hyperlink packages.
\RequirePackage{xepersian}
\settextfont[Path=fonts/,UprightFont=BNazanin.ttf,BoldFont=BNazaninBold.ttf]{BNazanin}
\newfontfamily\persiantitlefont[Path=fonts/,UprightFont=BTitr.ttf]{BTitr}
\setlatintextfont[Scale=0.85]{Roboto}
\newfontfamily\symbolfont{DejaVu Sans}
\renewcommand{\baselinestretch}{1.5}
\setlist[itemize]{leftmargin=1.7em,rightmargin=0pt,labelsep=.6em,itemsep=2pt,topsep=4pt}
\setlist[itemize,1]{label={\textcolor{DSCTeal}{\symbolfont\char"25CF}}}
\setlist[itemize,2]{label={\textcolor{DSCNavy}{\symbolfont\char"25CB}}}
\setlist[itemize,3]{label={\textcolor{DSCGold}{\symbolfont\char"25A0}}}
\lstdefinestyle{DSCCode}{basicstyle=\ttfamily\small,columns=fullflexible,keepspaces=true,breaklines=true,showstringspaces=false,backgroundcolor=\color{DSCPale},frame=single,rulecolor=\color{DSCLine},xleftmargin=0pt,xrightmargin=0pt,aboveskip=6pt,belowskip=6pt}

\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlength{\emergencystretch}{2em}
\renewcommand{\footnotelayout}{\normalfont\color{DSCInk}\raggedleft\setstretch{0.9}}
\renewcommand{\footnoterule}{\kern-3pt\hfill\textcolor{DSCTeal}{\rule{.3\columnwidth}{.5pt}}\kern3pt}
\titleformat{\chapter}[display]{\color{DSCNavy}\persiantitlefont\LARGE}{\normalfont\small\color{DSCTeal}\chaptername\ \thechapter}{5pt}{}[\vspace{6pt}\color{DSCLine}\titlerule]
\titlespacing*{\chapter}{0pt}{-8pt}{18pt}
\titleformat{\section}{\color{DSCNavy}\bfseries\Large}{\thesection}{.7em}{}
\titleformat{\subsection}{\color{DSCTeal}\bfseries\large}{\thesubsection}{.7em}{}
\titleformat{\subsubsection}{\color{DSCInk}\bfseries}{\thesubsubsection}{.7em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}
\newcommand{\DSCSeparator}{\enspace\textcolor{DSCLine}{\rule[-1pt]{.5pt}{9pt}}\enspace}
\newcommand{\DSCPageStyle}{%
  \fancyhf{}
  \fancyhead[R]{\small\textcolor{DSCMuted}{آخرین اصلاح: \DocumentDate}}
  \fancyhead[L]{\small\textcolor{DSCNavy}{\LabShortName}}
  \fancyfoot[R]{\small\textcolor{DSCMuted}{\DocumentCode\DSCSeparator نسخه \DocumentVersion}}
  \fancyfoot[L]{\small\textcolor{DSCTeal}{\thepage}}
  \renewcommand{\headrulewidth}{.5pt}
  \renewcommand{\footrulewidth}{0pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{DSCLine}\leaders\hrule height\headrulewidth\hfill}}
}
\pagestyle{fancy}
\DSCPageStyle
\fancypagestyle{plain}{\DSCPageStyle}
\assignpagestyle{\chapter}{fancy}
\newtcolorbox{DSCBox}[1]{enhanced,breakable,colback=DSCPale,colframe=DSCLine,boxrule=.5pt,arc=2mm,left=4mm,right=4mm,top=3mm,bottom=3mm,title={#1},colbacktitle=DSCNavy,coltitle=white,fonttitle=\bfseries}
\newcommand{\DSCLabel}[1]{{\small\color{DSCMuted}#1}}
\newcommand{\DSCNetwork}{%
  \begin{tikzpicture}[x=1cm,y=1cm]
    \draw[DSCLine,line width=.8pt] (0,0)--(1.3,1)--(3,0.3)--(4.4,1.3)--(6,.1);
    \draw[DSCLine,line width=.8pt] (1.3,1)--(2.1,2.3)--(4.4,1.3)--(5.6,2.4);
    \draw[DSCLine,line width=.8pt] (3,.3)--(3.3,2.7)--(5.6,2.4);
    \foreach \p in {(0,0),(1.3,1),(3,.3),(4.4,1.3),(6,.1),(2.1,2.3),(5.6,2.4),(3.3,2.7)}
      \fill[DSCTeal] \p circle (2.3pt);
    \fill[DSCGold] (4.4,1.3) circle (4pt);
  \end{tikzpicture}}
\newcommand{\MakeDSCCover}{%
  \begin{titlepage}\thispagestyle{empty}\setstretch{1.15}
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{\beginL%
      % Bottom identity band.
      \put(0,0){\color{DSCPale}\rule{\paperwidth}{32mm}}%
      % Dedicated left decorative border artwork.
      \put(0,0){\includegraphics[width=30mm,height=\paperheight]{assets/dsclab-cover-vertical.jpg}}%
      % Original right-side identity border.
      \put(\LenToUnit{\dimexpr\paperwidth-9mm\relax},0){\color{DSCNavy}\rule{9mm}{\paperheight}}%
      \put(\LenToUnit{\dimexpr\paperwidth-12mm\relax},\LenToUnit{\dimexpr\paperheight-175mm\relax}){\color{DSCTeal}\rule{3mm}{85mm}}%
      \endL
    }%
  }
  \noindent
  \begin{minipage}[c]{.70\linewidth}\raggedleft
    {\bfseries\Large دانشگاه علم و صنعت ایران\par}
    {\normalsize\color{DSCNavy}\LabName\par}
    {\small\lr{\LabEnglishName}\par}
  \end{minipage}\hfill
  \begin{minipage}[c]{.23\linewidth}\centering
    \includegraphics[width=28mm,height=30mm,keepaspectratio]{iust_logo.png}
  \end{minipage}\par
  \vspace{4mm}
  {\color{DSCLine}\rule{\linewidth}{.5pt}\par}
  \vspace{4mm}
  {\color{DSCTeal}\large\bfseries\DocumentType\par}
  \vspace{2mm}
  {\color{DSCNavy}\persiantitlefont\fontsize{25}{32}\selectfont\DocumentTitle\par}
  \vspace{2mm}
  {\color{DSCMuted}\large\DocumentSubtitle\par}
  \vspace{4mm}
  % Document metadata stays on the white/right side; artwork is page background.
  \noindent\hfill
  \begin{minipage}[t]{.50\linewidth}
    \raggedleft
    {\color{DSCTeal}\rule{18mm}{1.2pt}\par}
    \vspace{4mm}
    \begin{tabularx}{\linewidth}{@{}>{\raggedleft\arraybackslash}p{24mm}@{\hspace{5mm}}>{\raggedleft\arraybackslash}X@{}}
      \DSCLabel{تهیه‌کننده} & \PreparedBy\\[3mm]
      \DSCLabel{مخاطب} & \PreparedFor\\[3mm]
      \DSCLabel{شناسه سند} & \DocumentCode\\[3mm]
      \DSCLabel{نسخه} & \DocumentVersion\\[3mm]
      \DSCLabel{آخرین اصلاح} & \DocumentDate
    \end{tabularx}
    \vspace{3mm}
    {\color{DSCLine}\rule{\linewidth}{.5pt}\par}
  \end{minipage}\par
  \vfill
  {\raggedleft\footnotesize\color{DSCMuted}\DocumentAccess\par}
  \end{titlepage}}
